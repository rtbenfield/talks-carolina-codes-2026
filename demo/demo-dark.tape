# Dark-mode recording of the Firecracker snapshot-resume demo.
# See demo-steps.tape for prerequisites and the shared step script.

Output ../public/firecracker-demo-dark.webm

Set Shell bash
Set FontSize 24
Set Width 1800
Set Height 800
Set Padding 24
Set TypingSpeed 40ms
Set Theme "Chester"
Set WindowBar Colorful

Source demo-steps.tape
